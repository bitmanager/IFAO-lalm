# Copy to /etc/speech-mlflow/forward-<instance>.env on the tracking server.
SSH_HOST=source.example.internal
SSH_PORT=22
SSH_USER=metrics
SSH_KEY=/var/lib/speech-mlflow/ssh/forward_ed25519
SSH_KNOWN_HOSTS=/var/lib/speech-mlflow/ssh/known_hosts
# Reverse link: source collectors use localhost:15000 to reach tracking.
SSH_FORWARD_OPTION=-R
SSH_FORWARD_SPEC=127.0.0.1:15000:127.0.0.1:5000
