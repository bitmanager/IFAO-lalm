MLFLOW_ROOT=/var/lib/speech-mlflow/tracking
MLFLOW_EXECUTABLE=/var/lib/speech-mlflow/venv/bin/mlflow
MLFLOW_HOST=127.0.0.1
MLFLOW_PORT=5000
# Add the actual private dashboard host and port; keep explicit allowlists.
MLFLOW_ALLOWED_HOSTS=localhost,127.0.0.1,127.0.0.1:5000,tracking.example.internal:8445
MLFLOW_CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://tracking.example.internal:8445
