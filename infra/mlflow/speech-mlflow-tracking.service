[Unit]
Description=Persistent SpeechLLM MLflow tracking server
After=network-online.target
Wants=network-online.target

[Service]
User=speech-mlflow
Group=speech-mlflow
EnvironmentFile=/etc/speech-mlflow/tracking.env
WorkingDirectory=/var/lib/speech-mlflow/tracking
ExecStart=/usr/local/lib/speech-mlflow-monitor/start.sh
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/speech-mlflow/tracking

[Install]
WantedBy=multi-user.target
