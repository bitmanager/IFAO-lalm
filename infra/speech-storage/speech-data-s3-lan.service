# Native systemd TCP proxy; TLS terminates in MinIO, including certificate checks.
[Unit]
Description=SpeechLLM S3 private LAN TCP forwarding
Requires=speech-data-minio.service
After=speech-data-minio.service

[Service]
ExecStart=/usr/lib/systemd/systemd-socket-proxyd 127.0.0.1:19000
DynamicUser=true
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
