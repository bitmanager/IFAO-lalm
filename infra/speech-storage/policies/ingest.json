{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket", "s3:ListBucketMultipartUploads"],
      "Resource": ["arn:aws:s3:::speech-corpora", "arn:aws:s3:::speech-annotations", "arn:aws:s3:::speech-datasets"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion", "s3:PutObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": ["arn:aws:s3:::speech-corpora/*", "arn:aws:s3:::speech-annotations/*", "arn:aws:s3:::speech-datasets/*"]
    },
    {
      "Effect": "Deny",
      "Action": ["s3:*"],
      "Resource": ["arn:aws:s3:::speech-benchmarks", "arn:aws:s3:::speech-benchmarks/*"]
    }
  ]
}
