{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::speech-private-archive"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::speech-private-archive"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "sources/ru-replay80h/*",
            "sources/vod-native-calls8428/*"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::speech-private-archive/sources/ru-replay80h/*",
        "arn:aws:s3:::speech-private-archive/sources/vod-native-calls8428/*"
      ]
    }
  ]
}
